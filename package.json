{
  "name": "workspace-manager",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "bun_backend:dev": "bun run --cwd bun_backend scripts/dev.ts",
    "bun_backend:dev:web": "bun run --cwd bun_backend scripts/dev-web.ts",
    "bun_backend:dev:server": "bun run --cwd bun_backend scripts/dev-server.ts",
    "bun_backend:build": "tsc -b bun_backend && vite build --config bun_backend/vite.config.ts",
    "bun_backend:compile": "bun run --cwd bun_backend scripts/compile.ts",
    "bun_backend:compile:win": "bun run --cwd bun_backend scripts/compile.ts win",
    "bun_backend:compile:mac": "bun run --cwd bun_backend scripts/compile.ts mac",
    "bun_backend:compile:linux": "bun run --cwd bun_backend scripts/compile.ts linux",
    "bun_backend:start": "bun run --cwd bun_backend scripts/start.ts",
    "bun_backend:start:server": "bun run --cwd bun_backend server/index.ts",
    "bun_backend:lint": "cd bun_backend && eslint .",
    "bun_backend:format": "prettier --write \"bun_backend/**/*.{ts,tsx}\" \"frontend/**/*.{ts,tsx}\"",
    "bun_backend:typecheck": "tsc -b bun_backend --pretty false",
    "bun_backend:preview": "vite preview --config bun_backend/vite.config.ts",
    "electrobun_backend:start": "vite build --config electrobun_backend/vite.config.ts && cd electrobun_backend && electrobun dev",
    "electrobun_backend:dev": "cd electrobun_backend && electrobun dev --watch",
    "electrobun_backend:dev:hmr": "concurrently \"bun run electrobun_backend:hmr\" \"bun run electrobun_backend:start\"",
    "electrobun_backend:hmr": "vite --config electrobun_backend/vite.config.ts --port 5173",
    "electrobun_backend:build:canary": "vite build --config electrobun_backend/vite.config.ts && cd electrobun_backend && electrobun build --env=canary",
    "electrobun_backend:build:stable": "vite build --config electrobun_backend/vite.config.ts && cd electrobun_backend && electrobun build --env=stable",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "electrobun": "1.18.1",
    "handlebars": "^4.7.9",
    "lucide-react": "^1.30.0",
    "next-themes": "^0.4.6",
    "prismjs": "^1.30.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-simple-code-editor": "^0.14.1",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/bun": "latest",
    "@types/handlebars": "^4.1.0",
    "@types/node": "^24",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8"
  }
}
