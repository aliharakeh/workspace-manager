{
    "name": "workspace-manager",
    "version": "1.0.0",
    "description": "Desktop workspace manager built with Electrobun",
    "scripts": {
        "start": "vite build && electrobun dev",
        "dev": "electrobun dev --watch",
        "dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
        "hmr": "vite --port 5173",
        "build:canary": "vite build && electrobun build --env=canary",
        "build:stable": "vite build && electrobun build --env=stable",
        "db:generate": "drizzle-kit generate",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@base-ui/react": "^1.7.0",
        "@fontsource-variable/geist": "^5.3.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.45.2",
        "electrobun": "1.18.1",
        "handlebars": "^4.7.9",
        "lucide-react": "^1.30.0",
        "next-themes": "^0.4.6",
        "prismjs": "^1.30.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-simple-code-editor": "^0.14.1",
        "shadcn": "^4.16.2",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4",
        "@types/bun": "latest",
        "@types/handlebars": "^4.1.0",
        "@types/prismjs": "^1.26.6",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^4.3.4",
        "concurrently": "^9.1.0",
        "drizzle-kit": "^0.31.10",
        "tailwindcss": "^4",
        "typescript": "^5.7.2",
        "vite": "^6.0.3"
    }
}
